# Copiar a .env y ajustar los valores.
# El archivo .env no se versiona: contiene credenciales.

# ---------------------------------------------------------
# Base de datos
# ---------------------------------------------------------
DB_HOST=localhost
DB_NAME=spa_db
DB_USER=root
DB_PASS=

# Base de datos que usan las pruebas de integración.
# Se crea y se borra en cada ejecución, así que debe ser
# distinta de DB_NAME.
DB_NAME_TEST=spa_db_test

# ---------------------------------------------------------
# Autenticación
# ---------------------------------------------------------
# Clave para firmar los JWT. HS256 exige 32 bytes como mínimo:
# con menos, la librería falla y el login deja de funcionar.
# Generar una con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-32-bytes-o-mas

# Vigencia del token en segundos (3600 = 1 hora).
JWT_EXPIRE=3600

# ---------------------------------------------------------
# Entorno
# ---------------------------------------------------------
# 'local' o 'development' muestran los errores en pantalla.
# Cualquier otro valor, y también su ausencia, los ocultan.
APP_ENV=local
