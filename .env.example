; Copiar a .env y ajustar los valores.
; El archivo .env no se versiona: contiene credenciales.

; ---------------------------------------------------------
; Base de datos
; ---------------------------------------------------------
DB_HOST=localhost
DB_NAME=spa_db
DB_USER=root
DB_PASS=

; Base de datos que usan las pruebas de integración.
; Se crea y se borra en cada ejecución, así que debe ser
; distinta de DB_NAME.
DB_NAME_TEST=spa_db_test

; ---------------------------------------------------------
; Autenticación
; ---------------------------------------------------------
; Clave para firmar los JWT. HS256 exige 32 bytes como mínimo:
; con menos, la librería falla y el login deja de funcionar.
; Generar una con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-32-bytes-o-mas

; Vigencia del token en segundos (3600 = 1 hora).
JWT_EXPIRE=3600

; ---------------------------------------------------------
; Entorno
; ---------------------------------------------------------
; Zona horaria de la aplicación. De este reloj dependen las reglas de
; la agenda —si una cita está en el pasado, si una profesional tiene
; citas próximas—, así que la fija la aplicación y no el php.ini.
; Debe coincidir con la zona de MySQL.
APP_TIMEZONE=America/Bogota

; 'local' o 'development' muestran los errores en pantalla.
; Cualquier otro valor, y también su ausencia, los ocultan.
APP_ENV=local

; ---------------------------------------------------------
; Horario del salón
; ---------------------------------------------------------
; Rige las horas que se ofrecen para reservar y las que acepta la
; API. Son opcionales: sin ellas se aplican los valores de abajo.
; Un valor mal escrito hace fallar la reserva con un error claro,
; en lugar de aceptar citas a deshoras.

; Días de apertura, del 1 (lunes) al 7 (domingo), separados por comas.
SALON_DIAS=1,2,3,4,5,6

; Apertura y cierre, HH:MM. La cita entera, no solo su inicio, debe
; caber dentro: un servicio de 90 minutos no empieza después de las
; 17:30 si se cierra a las 19:00.
SALON_APERTURA=09:00
SALON_CIERRE=19:00

; Cada cuántos minutos se ofrece una hora de inicio.
SALON_INTERVALO=30

; Hasta cuántos días vista se puede reservar (56 = 8 semanas).
SALON_ANTELACION_MAX_DIAS=56
