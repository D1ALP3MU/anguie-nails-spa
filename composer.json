{
    "name": "alejo/anguie-nails",
    "description": "Sistema de gestión para Anguie Nails",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "backend/app/"
        }
    },
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    }
}
